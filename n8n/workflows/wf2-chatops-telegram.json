    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nlet texto = '🤖 *ChatOps — Guia do Turista Inteligente V3*\\n\\n';\n\nif (res.comando === '/status') {\n  texto += `✅ *Status:* \\`${res.status}\\`\\n`;\n  texto += `📦 *Aplicação:* ${res.aplicacao} v${res.versao}\\n`;\n  texto += `⏱️ *Uptime:* \\`${res.uptime_humano}\\`\\n`;\n  texto += `🔌 *Pool HTTP Ativo:* \\`${res.http_pool_ativo}\\``;\n} else if (res.comando === '/uptime') {\n  texto += `⏱️ *Uptime:* \\`${res.uptime_formatado}\\` (${res.uptime_segundos}s)\\n`;\n  texto += `🚀 *Iniciado em:* \\`${res.iniciado_em}\\``;\n} else if (res.comando === '/telemetria') {\n  texto += `📊 *Roteiros Calculados:* \\`${res.total_roteiros_calculados}\\`\\n`;\n  texto += `⚡ *Requisições Ativas:* \\`${res.requisicoes_em_andamento}\\`\\n`;\n  texto += `🕒 *Latência Média:* \\`${res.latencia_media_ms} ms\\`\\n`;\n  texto += `📨 *Eventos n8n Recentes:* \\`${res.eventos_n8n_recentes}\\``;\n} else if (res.comando === '/testardlq') {\n  texto += `🧪 *Simulação DLQ Executada!*\\n`;\n  texto += `🆔 *UUID:* \\`${res.trace_id}\\`\\n`;\n  texto += `⚙️ *Execução:* \\`${res.execucao}\\`\\n`;\n  texto += `📝 ${res.mensagem}`;\n} else {\n  texto += '```json\\n' + JSON.stringify(res, null, 2) + '\\n```';\n}\n\nreturn [{ json: { chat_id: chatId, resposta_markdown: texto } }];"
      },
