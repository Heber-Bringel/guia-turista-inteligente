# Variáveis de ambiente — copie este arquivo para .env e preencha os valores

# ----------------------------------------------------------------------------
# Chave da API do Google Gemini AI
# Obtenha gratuitamente em: https://aistudio.google.com/
# ----------------------------------------------------------------------------
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# ----------------------------------------------------------------------------
# Client ID do Google OAuth2 (já configurado pelo professor para este projeto)
# Não altere se for usar o ambiente local padrão
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=776335673676-dk7od4ljhh43bio4bppf94i8ou0u9v9i.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# Porta e Host do servidor FastAPI (padrão: 8001 / 0.0.0.0)
# ----------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Origens permitidas no CORS (separadas por vírgula ou JSON)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ----------------------------------------------------------------------------
# Persistência e Timeouts da Aplicação
# ----------------------------------------------------------------------------
DATA_FILE_PATH=static/data/viagens.json
TIMEOUT_SEGUNDOS=10.0
VISITANTE_TTL_SEGUNDOS=7200

# ----------------------------------------------------------------------------
# Segurança Operacional (ChatOps / Suporte V3)
# ----------------------------------------------------------------------------
# Troque por uma chave longa e aleatória; o WF 2 (ChatOps) envia o mesmo valor no cabeçalho X-Support-Key
SUPPORT_API_KEY=troque-por-uma-chave-segura-de-suporte

# ----------------------------------------------------------------------------
# Integração n8n (Arquitetura Orientada a Eventos - V3)
# ----------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_DLQ=/webhook/turismo-dlq
N8N_WEBHOOK_DESPACHAR_ROTEIRO=/webhook/turismo-despachar-roteiro
N8N_WEBHOOK_CLIMA=/webhook/turismo-clima
TIMEOUT_N8N=5.0

# ----------------------------------------------------------------------------
# Variáveis lidas pelos workflows do n8n ($env.*) — n8n/docker-compose.yml
# repassa este arquivo ao container. O token do bot do Telegram NÃO fica aqui:
# cadastre-o como credencial "Telegram API" dentro do n8n (WF 1 e WF 2).
# ----------------------------------------------------------------------------
# Libera o acesso a $env nos nós do n8n (bloqueado por padrão nas versões recentes)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Endereço do FastAPI visto de dentro do container do n8n (WF 2 - ChatOps)
FASTAPI_BASE_URL=http://host.docker.internal:8001
# Chat ID do grupo/usuário autorizado no Telegram (WF 1 - alertas DLQ e WF 2 - comandos)
TELEGRAM_SUPPORT_CHAT_ID=SEU_CHAT_ID_AQUI
# Modelo usado pelo WF 4 (Clima + Gemini); a chave é a mesma GEMINI_API_KEY acima
GEMINI_MODEL=gemini-2.5-flash
# WF 3 - Despacho por E-mail (Resend)
RESEND_API_KEY=SUA_CHAVE_RESEND_AQUI
EMAIL_FROM=Guia do Turista <onboarding@resend.dev>
# WF 3 - Despacho por WhatsApp (Evolution API)
WHATSAPP_API_URL=http://host.docker.internal:8080
WHATSAPP_INSTANCE=guia-turista
WHATSAPP_API_KEY=SUA_CHAVE_EVOLUTION_AQUI
