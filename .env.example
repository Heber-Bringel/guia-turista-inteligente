# Variáveis de ambiente — copie este arquivo para .env e preencha os valores

# ----------------------------------------------------------------------------
# Chave da API do Google Gemini AI
# Obtenha gratuitamente em: https://aistudio.google.com/
# ----------------------------------------------------------------------------
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# ----------------------------------------------------------------------------
# Client ID do Google OAuth2 (já configurado pelo professor para este projeto)
# Não altere se for usar o ambiente local padrão
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=776335673676-dk7od4ljhh43bio4bppf94i8ou0u9v9i.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# Porta e Host do servidor FastAPI (padrão: 8001 / 0.0.0.0)
# ----------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Origens permitidas no CORS (separadas por vírgula ou JSON)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ----------------------------------------------------------------------------
# Persistência e Timeouts da Aplicação
# ----------------------------------------------------------------------------
DATA_FILE_PATH=static/data/viagens.json
TIMEOUT_SEGUNDOS=10.0
VISITANTE_TTL_SEGUNDOS=7200
